# ---------- 配置持久化 ----------

def load_config() -> dict:
    cfg = {}
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        pass
    for k, v in DEFAULT_CONFIG.items():
        cfg.setdefault(k, v)
    return cfg


def save_config(cfg: dict) -> None:
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
    except Exception:
        pass


# ---------- 异步工具 ----------

async def run_cmd(args: list[str], timeout: float = 10) -> tuple[Optional[int], str]:
    """运行子进程，返回 (returncode, stdout)。失败返回 (None, '')。"""
    try:
        proc = await asyncio.create_subprocess_exec(
            *args,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout)
        return proc.returncode, out.decode(errors="replace").strip()
    except Exception:
        return None, ""


_secret_cache = {"mtime": None, "value": ""}


def _read_secret() -> str:
    try:
        st = os.stat(SECRET_PATH)
        if _secret_cache["mtime"] != st.st_mtime:
            with open(SECRET_PATH, encoding="utf-8") as f:
                _secret_cache["value"] = f.read().strip()
            _secret_cache["mtime"] = st.st_mtime
        return _secret_cache["value"]
    except Exception:
        return ""


_NO_PROXY_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def _http_request(method: str, path: str, data: Optional[str] = None, timeout: float = 5) -> tuple[int, str]:
    """同步 HTTP 请求，供 asyncio.to_thread 调用。"""
    body = data.encode() if data is not None else None
    req = urllib.request.Request(API + path, data=body, method=method)
    secret = _read_secret()
    if secret:
        req.add_header("Authorization", "Bearer " + secret)
    with _NO_PROXY_OPENER.open(req, timeout=timeout) as resp:
        return resp.status, resp.read().decode(errors="replace")


async def api_get(path: str, timeout: float = 5) -> Optional[Any]:
    try:
        _, body = await asyncio.to_thread(_http_request, "GET", path, None, timeout)
        if body:
            return json.loads(body)
    except Exception:
        pass
    return None


async def api_put(path: str, data: str, timeout: float = 5) -> bool:
    try:
        status, _ = await asyncio.to_thread(_http_request, "PUT", path, data, timeout)
        return status in (200, 204)
    except Exception:
        return False


# ---------- 数据层 ----------

async def is_active() -> bool:
    rc, out = await run_cmd(["systemctl", "is-active", "sing-box"], timeout=5)
    return out == "active"


async def service(action: str) -> None:
    await run_cmd(["sudo", "-n", "systemctl", action, "sing-box"], timeout=10)


async def get_proxy_state() -> tuple[str, str]:
    p, a = await asyncio.gather(
        api_get("/proxies/proxy"),
        api_get("/proxies/auto"),
    )
    return (p.get("now", "—") if p else "—"), (a.get("now", "—") if a else "—")


async def get_nodes() -> list[str]:
    p = await api_get("/proxies/proxy")
    if p and "all" in p:
        return p["all"]
    return ["auto", "vless-v6", "vless-v4", "tuic-v6", "tuic-v4", "hy2-v6", "hy2-v4"]


async def node_delay(tag: str, timeout: float = 6) -> Optional[int]:
    url = "/proxies/%s/delay?timeout=5000&url=http%%3A%%2F%%2Fwww.gstatic.com%%2Fgenerate_204" % tag
    d = await api_get(url, timeout=timeout)
    if d and "delay" in d:
        return d["delay"]
    return None


async def set_proxy(name: str) -> bool:
    return await api_put("/proxies/proxy", '{"name":"%s"}' % name)


async def ping_vps(ip: str, port: int = 443, timeout: float = 5) -> Optional[int]:
    t0 = time.time()
    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(ip, port), timeout=timeout)
        writer.close()
        await writer.wait_closed()
        return int((time.time() - t0) * 1000)
    except Exception:
        return None



async def get_version() -> str:
    d = await api_get("/version", timeout=3)
    if d and "version" in d:
        return d["version"]
    return "—"


async def get_node_ips() -> dict[str, str]:
    try:
        rc, out = await run_cmd(["sudo", "-n", "cat", "/etc/sing-box/config.json"], timeout=5)
        if rc != 0:
            return {}
        cfg = json.loads(out)
        ips = {}
        for ob in cfg.get("outbounds", []):
            if ob.get("type") in ("vless", "tuic", "hysteria2") and ob.get("tag"):
                ips[ob["tag"]] = "%s:%s" % (ob.get("server", "?"), ob.get("server_port", "?"))
        return ips
    except Exception:
        return {}


async def get_default_iface() -> str:
    rc, out = await run_cmd(["ip", "route", "show", "default"], timeout=5)
    line = out
    if "dev " in line:
        return line.split("dev ")[1].split()[0]
    return "—"


async def egress() -> str:
    rc, out = await run_cmd(
        ["curl", "-s", "--noproxy", "*", "--max-time", "6", "-4", "https://api.ipify.org"],
        timeout=8,
    )
    return out if rc == 0 else "—"


async def err_warn_count(hours: int = 1) -> int:
    rc, out = await run_cmd(
        ["journalctl", "-u", "sing-box", "--since", "%d hours ago" % hours, "--no-pager"],
        timeout=10,
    )
    if rc is None:
        return 0
    try:
        return sum(1 for line in out.splitlines() if "ERROR" in line or "WARNING" in line)
    except Exception:
        return 0


async def uptime_str() -> str:
    rc, out = await run_cmd(
        ["systemctl", "show", "sing-box", "-p", "ActiveEnterTimestamp", "--value"],
        timeout=5,
    )
    ts = out
    if not ts:
        return "—"
    try:
        t = time.mktime(time.strptime(ts, "%a %Y-%m-%d %H:%M:%S %Z"))
        secs = max(0, int(time.time() - t))
    except Exception:
        return "—"
    d, rem = divmod(secs, 86400)
    h, m = divmod(rem, 3600)
    m, _ = divmod(m, 60)
    if d > 0:
        return "%d天%d时" % (d, h)
    if h > 0:
        return "%d时%d分" % (h, m)
    return "%d分" % m


async def conn_count(vps_ip: str) -> int:
    rc, out = await run_cmd(["ss", "-tn"], timeout=5)
    if rc is None:
        return 0
    return sum(1 for line in out.splitlines() if vps_ip in line and ":443" in line)


async def speed_test(url: str, timeout: float = 45) -> Optional[tuple[float, float]]:
    try:
        proc = await asyncio.create_subprocess_exec(
            "curl", "-s", "-x", "http://127.0.0.1:%d" % PROXY_PORT,
            "--max-time", str(timeout), "-o", "/dev/null",
            "-w", "%{speed_download} %{time_total}", url,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
        )
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout + 5)
        if proc.returncode == 0 and out:
            speed, total = out.decode().split()
            return float(speed) / 1048576, float(total)
    except Exception:
        pass
    return None


async def udp_health() -> str:
    try:
        proc = await asyncio.create_subprocess_exec(
            os.path.expanduser("~/.local/bin/singbox-udp-health"), "8",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
        )
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=90)
        lines = out.decode(errors="replace").strip().splitlines()
        return lines[-1] if lines else "检测失败"
    except Exception:
        return "检测失败"


async def run_script(script: str, *args: str, timeout: float = 120) -> str:
    try:
        proc = await asyncio.create_subprocess_exec(
            os.path.expanduser("~/.local/bin/" + script), *args,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT,
        )
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout)
        return out.decode(errors="replace").strip()
    except Exception:
        return ""


async def journal_stream(callback: Callable[[str], Any], stop_event: asyncio.Event) -> None:
    proc = await asyncio.create_subprocess_exec(
        "journalctl", "-u", "sing-box", "-f", "--no-pager", "-o", "short-iso",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
    )
    if proc.stdout is None:
        return
    try:
        while not stop_event.is_set():
            line = await proc.stdout.readline()
            if not line:
                break
            result = callback(line.decode(errors="replace").rstrip())
            if asyncio.iscoroutine(result):
                await result
    finally:
        proc.kill()
        await proc.wait()


async def traffic_stream(callback: Callable[[dict], Any], stop_event: asyncio.Event) -> None:
    """持续读取 /traffic 流式接口，断线自动重连。"""
    while not stop_event.is_set():
        secret = _read_secret()
        cmd = ["curl", "-sN"]
        if secret:
            cmd += ["-H", "Authorization: Bearer " + secret]
        cmd += [API + "/traffic"]
        try:
            proc = await asyncio.create_subprocess_exec(
                *cmd,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.DEVNULL,
            )
        except Exception:
            await asyncio.sleep(2)
            continue
        if proc.stdout is None:
            await asyncio.sleep(2)
            continue
        try:
            while not stop_event.is_set():
                line = await proc.stdout.readline()
                if not line:
                    break
                try:
                    data = json.loads(line)
                except Exception:
                    continue
                result = callback(data)
                if asyncio.iscoroutine(result):
                    await result
        finally:
            proc.kill()
            await proc.wait()
        if not stop_event.is_set():
            await asyncio.sleep(2)


def fmt_bytes(n: float) -> str:
    try:
        n = float(n)
    except Exception:
        return "0B"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return "%.1f%s" % (n, unit) if unit != "B" else "%d%s" % (int(n), unit)
        n /= 1024
    return "%d%s" % (int(n), "TB")


