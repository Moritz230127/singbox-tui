MODULES = ["indicator-panel", "power-mode-panel", "traffic-panel", "node-panel", "log"]


class SingboxApp(App):
    CSS = CSS
    TITLE = "sing-box 控制台"

    def __init__(self):
        super().__init__()
        self.ui_mode = "normal"       # normal / edit / command
        self.edit_target = None       # "mode" | "node"
        self.focus_idx = 0            # normal 模式模块焦点
        self.cmd_buf = ""
        self.cfg = load_config()
        self.nodes = []
        self.state = {"active": False, "proxy": "—", "auto": "—", "egress": "—",
                      "err1h": "—", "conns": "—", "uptime": "—"}
        self.lat = {}                 # 节点链路延迟
        self.ping = None              # VPS 直连延迟 (ms)
        self.speed = {}               # 节点下载速度 (MB/s)
        self.speed_tested = set()    # 已测速节点
        self.download = "—"
        self.udp = "—"
        self.block_count = 0          # block 拒绝计数（1h 窗口）
        self.node_ips = {}            # 节点 tag→server:port
        self.version = "—"            # sing-box 版本
        self.iface = "—"              # 默认网卡
        self.traffic_up = 0           # 累计上传字节
        self.traffic_down = 0
        self.rate_up = 0.0            # 实时速率 B/s
        self.rate_down = 0.0
        self._last_traffic = None
        self._last_traffic_t = 0.0
        self.node_sel = 0
        self.mode_sel = 0
        self.log_follow = True
        self.log_filter = "all"       # all / error / warn
        self._log_stop = asyncio.Event()
        self._speed_running = False
        self._err_tick = 0

    # ---------- 布局 ----------
    def compose(self) -> ComposeResult:
        yield Static("", id="hint")
        with Horizontal(id="console"):
            with Vertical(id="indicator-panel", classes="panel"):
                yield Static("", id="indicator")
            with Vertical(id="power-mode-panel", classes="panel"):
                yield Static("", id="power")
                yield Static("", id="mode")
            with Vertical(id="traffic-panel", classes="panel"):
                yield Static("", id="traffic")
            with Vertical(id="node-panel", classes="panel"):
                yield DataTable(id="node-table")
        yield RichLog(id="log", markup=True, auto_scroll=True, wrap=True, max_lines=500)
        yield Static("", id="cmdline")
        yield Static("终端太小，请放大窗口（建议 ≥100x20）", id="too-small")

    # ---------- 生命周期 ----------
    async def on_mount(self):
        self.register_theme(Theme(**NOCTALIA))
        self.theme = "noctalia"
        # btop 风格边框标题
        self.query_one("#indicator-panel").border_title = "状态指示器"
        self.query_one("#power-mode-panel").border_title = "控制"
        self.query_one("#traffic-panel").border_title = "流量"
        self.query_one("#node-panel").border_title = "节点"
        self.query_one("#log").border_title = "日志"
        # 初始化节点表格
        dt = self.query_one("#node-table")
        self.col_node = dt.add_column("节点", width=12)
        self.col_ip = dt.add_column("IP", width=20)
        self.col_ping = dt.add_column("ping", width=5)
        self.col_link = dt.add_column("链路", width=5)
        self.col_speed = dt.add_column("速度", width=4)
        dt.cursor_type = "row"
        dt.zebra_stripes = True
        self.nodes = await get_nodes()
        self.row_keys = {}
        for n in self.nodes:
            self.row_keys[n] = dt.add_row("", "", "", "", "", key=n)
        cur = self.state.get("proxy")
        if cur in self.nodes:
            self.node_sel = self.nodes.index(cur)
        # 读取节点 IP / 版本 / 网卡（启动时缓存）
        self.node_ips = await get_node_ips()
        self.version = await get_version()
        self.iface = await get_default_iface()
        # 恢复上次 :wq 保存的状态
        if self.cfg["mode"] == "manual" and self.cfg["node"] in self.nodes:
            await set_proxy(self.cfg["node"])
        elif self.cfg["mode"] == "auto":
            await set_proxy("auto")
        asyncio.create_task(self.poll_state())
        asyncio.create_task(journal_stream(self.on_log_line, self._log_stop))
        self.log_inject("TUI 启动 (模式: %s)" % self.cfg["mode"])
        asyncio.create_task(self.refresh_once())  # 启动即刷新状态
        self.refresh_panels()

    def on_unmount(self):
        self._log_stop.set()

    def on_resize(self, event):
        """终端过小时显示提示（btop 风格），隐藏主界面"""
        w, h = event.size.width, event.size.height
        too_small = w < 100 or h < 20
        self.query_one("#too-small").display = too_small
        self.query_one("#hint").display = not too_small
        self.query_one("#console").display = not too_small
        self.query_one("#log").display = not too_small
        self.query_one("#cmdline").display = not too_small

    # ---------- 后台任务 ----------
    async def poll_state(self):
        while True:
            try:
                self.state["active"] = await is_active()
                if self.state["active"]:
                    p, a = await get_proxy_state()
                    self.state["proxy"], self.state["auto"] = p, a
                    self.state["conns"] = await conn_count(self.cfg["vps_ip"])
                    self.state["uptime"] = await uptime_str()
                    # 流量轮询（每 2s 计算速率）
                    up, down = await get_traffic()
                    now = time.time()
                    if self._last_traffic is not None:
                        dt = now - self._last_traffic_t
                        if dt > 0:
                            self.rate_up = max(0, (up - self._last_traffic[0]) / dt)
                            self.rate_down = max(0, (down - self._last_traffic[1]) / dt)
                    self._last_traffic = (up, down)
                    self._last_traffic_t = now
                    self.traffic_up, self.traffic_down = up, down
                    self._err_tick += 1
                    if self._err_tick % 5 == 0:  # 每 10s 重操作
                        self.state["egress"] = await egress()
                        self.state["err1h"] = await err_warn_count(1)
                self.refresh_panels()
            except Exception:
                pass
            await asyncio.sleep(2)

    async def refresh_once(self):
        self.state["active"] = await is_active()
        if self.state["active"]:
            p, a = await get_proxy_state()
            self.state["proxy"], self.state["auto"] = p, a
            self.state["egress"] = await egress()
            self.state["err1h"] = await err_warn_count(1)
            self.state["conns"] = await conn_count(self.cfg["vps_ip"])
            self.state["uptime"] = await uptime_str()
        self.refresh_panels()

    async def run_speedtest(self):
        if self._speed_running:
            return
        self._speed_running = True
        self.udp = "—"
        self.download = "测速中..."
        self.refresh_panels()
        # 记录原节点，测速后恢复
        orig = self.state.get("proxy", "auto")
        # 1. 并行测 ping（VPS 直连）+ 链路延迟（clash API）
        vps_ip = self.cfg["vps_ip"]
        ping_task = asyncio.create_task(ping_vps(vps_ip))
        lat_tasks = [node_delay(n) for n in self.nodes]
        lat_results = await asyncio.gather(*lat_tasks)
        self.lat = dict(zip(self.nodes, lat_results))
        self.ping = await ping_task
        # 2. 对每个具体节点依次切换测下载速度（链路延迟 None 的节点跳过，避免超时）
        name, url = self.cfg["speed_urls"][0]
        for n in self.nodes:
            if n == "auto":
                continue
            self.speed_tested.add(n)
            self.download = "测速中: %s..." % n
            self.refresh_panels()
            await set_proxy(n)
            if self.lat.get(n) is None:
                self.speed[n] = None  # 节点不可达（如校园网 UDP 封禁），跳过下载
                continue
            r = await speed_test(url)
            self.speed[n] = r[0] if r else None
        # 3. 恢复原节点
        await set_proxy(orig)
        self.download = "完成"
        # 4. UDP 链路健康
        self.udp = await udp_health()
        self._speed_running = False
        self.log_inject("测速完成: ping %s, %d 节点, UDP %s" % (self.ping, len(self.nodes) - 1, self.udp))
        await self.refresh_once()

    # ---------- 日志 ----------
    def on_log_line(self, line):
        # block 拒绝：只计数不显示（避免刷屏），计数显示在状态指示器
        if "outbound/block" in line or "operation not permitted" in line:
            self.block_count += 1
            return
        # 日志过滤
        if self.log_filter == "error" and "ERROR" not in line:
            return
        if self.log_filter == "warn" and "ERROR" not in line and "WARNING" not in line:
            return
        safe = escape(line)
        safe = safe.replace("ERROR", "[bold red]ERROR[/bold red]")
        safe = safe.replace("WARNING", "[bold yellow]WARNING[/bold yellow]")
        self.query_one("#log", RichLog).write(safe)

    def log_inject(self, msg):
        self.query_one("#log", RichLog).write("[bold cyan][TUI][/bold cyan] " + msg)

    # ---------- 面板渲染 ----------
    def hint_text(self):
        return ("[:start] [:stop] [:mode] [:node] [:speed] [:refresh] [:wq] [:q]\n"
                "[:iface] [:subscribe] [:backup] [:rules-update] [:udp] [:env] [:guard] [:log]")

    def log_title(self):
        """日志边框标题（含过滤状态）"""
        return "日志" + (" [%s]" % self.log_filter if self.log_filter != "all" else "")

    def indicator_text(self):
        s = self.state
        active = s["active"]
        st = "运行中" if active else "已停止"
        st_style = "green" if active else "red"
        mode = "自动" if s["proxy"] == "auto" else "手动"
        return (f"[{st_style}]●[/{st_style}] {st} | {mode}\n"
                f"{self.version}\n"
                f"出口: {s['egress']}\n"
                f"错误(1h): {s['err1h']} | 连接: {s['conns']}\n"
                f"运行: {s['uptime']} | {self.iface}\n"
                f"UDP: {self.udp}\n"
                f"block: {self.block_count}")

    def traffic_text(self):
        return (f"↑ {fmt_bytes(self.rate_up)}/s\n"
                f"↓ {fmt_bytes(self.rate_down)}/s\n"
                f"总 ↑ {fmt_bytes(self.traffic_up)}\n"
                f"总 ↓ {fmt_bytes(self.traffic_down)}")

    def power_text(self):
        active = self.state["active"]
        return (f"开关: [{('green' if active else 'red')}]●[/]")

    def mode_text(self):
        cur = "auto" if self.state["proxy"] == "auto" else "manual"
        lines = []
        if self.ui_mode == "edit" and self.edit_target == "mode":
            for i, m in enumerate(["自动", "手动"]):
                mark = ">" if i == self.mode_sel else " "
                if i == self.mode_sel:
                    lines.append(f"{mark} [reverse]{m}[/]")
                else:
                    lines.append(f"{mark} {m}")
        else:
            lines.append("模式: " + ("自动" if cur == "auto" else "手动"))
        return "\n".join(lines)

    def refresh_node_table(self):
        """更新节点表格（延迟/速度/IP）"""
        dt = self.query_one("#node-table")
        cur = self.state.get("proxy")
        for i, n in enumerate(self.nodes):
            ip = self.node_ips.get(n, "—")
            ps = "—" if self.ping is None else "%dms" % self.ping
            lat = self.lat.get(n)
            ls = "—" if lat is None else "%dms" % lat
            sp = self.speed.get(n)
            if n in self.speed_tested:
                ss = "—" if n == "auto" else ("失败" if sp is None else "%.1fM" % sp)
            else:
                ss = "—"
            label = ("★ " if n == cur else "  ") + ("自动选优" if n == "auto" else n)
            rk = self.row_keys.get(n)
            if rk is None:
                continue
            dt.update_cell(rk, self.col_node, label)
            dt.update_cell(rk, self.col_ip, ip)
            dt.update_cell(rk, self.col_ping, ps)
            dt.update_cell(rk, self.col_link, ls)
            dt.update_cell(rk, self.col_speed, ss)
        # 光标跟随当前节点（normal 模式）
        if self.ui_mode != "edit":
            if cur in self.nodes:
                dt.cursor_coordinate = Coordinate(self.nodes.index(cur), 0)

    def cmdline_text(self):
        if self.ui_mode == "command":
            return ":" + self.cmd_buf + "▌"
        return ""

    def refresh_panels(self):
        self.query_one("#hint", Static).update(self.hint_text())
        self.query_one("#indicator", Static).update(self.indicator_text())
        self.query_one("#power", Static).update(self.power_text())
        self.query_one("#mode", Static).update(self.mode_text())
        self.query_one("#traffic", Static).update(self.traffic_text())
        self.refresh_node_table()
        self.query_one("#cmdline", Static).update(self.cmdline_text())
        self.query_one("#log").border_title = self.log_title()
        self.update_focus_border()

    def update_focus_border(self):
        for i, m in enumerate(MODULES):
            w = self.query_one("#" + m)
            w.set_class(i == self.focus_idx and self.ui_mode == "normal", "focused")

    # ---------- 命令 ----------
    def exec_command(self, cmd):
        cmd = cmd.strip()
        if cmd in ("start", "stop"):
            asyncio.create_task(self.do_service(cmd))
        elif cmd == "mode":
            self.ui_mode = "edit"
            self.edit_target = "mode"
            self.mode_sel = 0 if self.state.get("proxy") == "auto" else 1
            cur = self.state.get("proxy")
            if cur in self.nodes:
                self.node_sel = self.nodes.index(cur)
        elif cmd == "node":
            self.ui_mode = "edit"
            self.edit_target = "node"
            cur = self.state.get("proxy")
            if cur in self.nodes:
                self.node_sel = self.nodes.index(cur)
            # 聚焦 DataTable，光标定位到当前节点
            dt = self.query_one("#node-table")
            dt.focus()
            dt.cursor_coordinate = Coordinate(self.node_sel, 0)
        elif cmd == "speed":
            asyncio.create_task(self.run_speedtest())
            self.ui_mode = "normal"
        elif cmd == "refresh":
            asyncio.create_task(self.refresh_once())
            self.ui_mode = "normal"
        elif cmd.startswith("iface"):
            name = cmd.split()[1] if len(cmd.split()) > 1 else ""
            if not name:
                self.notify("用法: :iface <网卡名>")
            else:
                asyncio.create_task(self.run_script_cmd("singbox-switch-iface", [name], "网卡切换"))
            self.ui_mode = "normal"
        elif cmd.startswith("subscribe"):
            args = ["--apply"] if "--apply" in cmd else []
            asyncio.create_task(self.run_script_cmd("singbox-subscribe", args, "订阅同步"))
            self.ui_mode = "normal"
        elif cmd == "backup":
            asyncio.create_task(self.run_script_cmd("singbox-vps-backup", [], "VPS 备份"))
            self.ui_mode = "normal"
        elif cmd == "rules-update":
            asyncio.create_task(self.run_script_cmd("singbox-rules-update", [], "规则更新"))
            self.ui_mode = "normal"
        elif cmd == "udp":
            asyncio.create_task(self.run_udp_check())
            self.ui_mode = "normal"
        elif cmd == "env":
            asyncio.create_task(self.run_script_cmd("singbox-env-detect", [], "环境检测"))
            self.ui_mode = "normal"
        elif cmd == "guard":
            asyncio.create_task(self.run_script_cmd("singbox", ["guard"], "健康守卫"))
            self.ui_mode = "normal"
        elif cmd.startswith("log"):
            parts = cmd.split()
            if len(parts) > 1 and parts[1] in ("error", "warn", "all"):
                self.log_filter = parts[1]
                self.log_inject("日志过滤: %s" % parts[1])
            else:
                self.notify("用法: :log error|warn|all")
            self.ui_mode = "normal"
        elif cmd == "wq":
            self.save_and_exit()
            return
        elif cmd == "q":
            self.exit()
            return
        else:
            self.notify("未知命令: %s" % cmd)
            self.ui_mode = "normal"
        self.cmd_buf = ""
        self.refresh_panels()

    async def run_script_cmd(self, script, args, label):
        """调配套脚本，输出注入日志（后台不阻塞）"""
        self.log_inject("%s: 执行中..." % label)
        out = await run_script(script, *args)
        if out:
            for line in out.splitlines()[:8]:
                self.log_inject("%s: %s" % (label, line[:100]))
        else:
            self.log_inject("%s: 无输出或失败" % label)
        if script == "singbox-switch-iface":
            self.iface = await get_default_iface()
        await self.refresh_once()

    async def run_udp_check(self):
        """UDP 健康检测，结果缓存显示"""
        self.udp = "检测中..."
        self.refresh_panels()
        out = await run_script("singbox-udp-health", "8")
        self.udp = out.splitlines()[-1][:20] if out else "检测失败"
        self.log_inject("UDP 检测: %s" % self.udp)
        self.refresh_panels()

    async def do_service(self, action):
        await service(action)
        self.log_inject("已%s代理" % ("开启" if action == "start" else "关闭"))
        await self.refresh_once()

    async def confirm_edit(self):
        if self.edit_target == "mode":
            if self.mode_sel == 0:
                ok = await set_proxy("auto")
                self.log_inject("已切到自动模式" if ok else "切换失败")
            else:
                # 手动：保持当前节点（若 auto 则用 node_sel 或默认）
                cur = self.state.get("proxy")
                name = cur if cur != "auto" else (self.nodes[self.node_sel] if self.nodes else "vless-v6")
                if name == "auto":
                    name = "vless-v6"
                ok = await set_proxy(name)
                self.log_inject("已切到手动: %s" % name if ok else "切换失败")
        elif self.edit_target == "node":
            # 从 DataTable 光标读取选中节点
            dt = self.query_one("#node-table")
            row = dt.cursor_coordinate.row
            name = self.nodes[row] if 0 <= row < len(self.nodes) else "auto"
            if name == "auto":
                ok = await set_proxy("auto")
                self.log_inject("已切到自动模式" if ok else "切换失败")
            else:
                ok = await set_proxy(name)
                self.log_inject("已切换到: %s" % name if ok else "切换失败")
        self.ui_mode = "normal"
        self.edit_target = None
        self.query_one("#node-table").blur()
        await self.refresh_once()

    def save_and_exit(self):
        proxy = self.state.get("proxy", "auto")
        mode = "auto" if proxy == "auto" else "manual"
        node = proxy if mode == "manual" else self.cfg.get("node", "vless-v6")
        self.cfg["mode"] = mode
        self.cfg["node"] = node
        save_config(self.cfg)
        self.exit()

    # ---------- 按键 ----------
    def on_key(self, event):
        key = event.key
        char = event.character
        if self.ui_mode == "command":
            if key == "escape":
                self.ui_mode = "normal"
                self.cmd_buf = ""
            elif key == "enter":
                self.exec_command(self.cmd_buf)
                return
            elif key == "backspace":
                self.cmd_buf = self.cmd_buf[:-1]
            elif char and char.isprintable():
                self.cmd_buf += char
            self.refresh_panels()
            return
        if self.ui_mode == "edit":
            if key == "escape":
                self.ui_mode = "normal"
                self.edit_target = None
                self.query_one("#node-table").blur()
            elif key in ("up", "down"):
                if self.edit_target == "mode":
                    d = 1 if key == "down" else -1
                    self.mode_sel = (self.mode_sel + d) % 2
                # edit_target == "node" 时 ↑↓ 由 DataTable 处理（聚焦）
            elif key == "enter":
                asyncio.create_task(self.confirm_edit())
                return
            self.refresh_panels()
            return
        # normal
        if char == ":":
            self.ui_mode = "command"
            self.cmd_buf = ""
        elif key == "up":
            self.focus_idx = (self.focus_idx - 1) % len(MODULES)
        elif key == "down":
            self.focus_idx = (self.focus_idx + 1) % len(MODULES)
        elif key == "q":
            self.exit()
            return
        self.refresh_panels()

    # ---------- 鼠标（滚轮仅日志） ----------
    def on_mouse_scroll_down(self, event):
        log = self.query_one("#log", RichLog)
        if log.is_vertical_scroll_end:
            self.log_follow = True
            log.auto_scroll = True
        else:
            self.log_follow = False
            log.auto_scroll = False

    def on_mouse_scroll_up(self, event):
        self.log_follow = False
        self.query_one("#log", RichLog).auto_scroll = False


if __name__ == "__main__":
    SingboxApp().run()
