API = "http://127.0.0.1:9090"
PROXY_PORT = 7897
CONFIG_PATH = os.path.expanduser("~/.config/singbox-tui/config.json")
SECRET_PATH = os.path.expanduser("~/.config/singbox-tui.secret")

# ---------- 配置持久化 ----------

DEFAULT_CONFIG = {
    "mode": "auto",
    "node": "vless-v6",
    "vps_ip": "YOUR_VPS_IP",
    "speed_urls": [
        ("Cloudflare 10MB", "https://speed.cloudflare.com/__down?bytes=10000000"),
