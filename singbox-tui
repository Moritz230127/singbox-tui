import re

MARKUP_RE = re.compile(r"\[[^\]]*\]")


def _plain(s):
    """剥离 markup 标签（如 [red]失败[/red] → 失败）"""
    return MARKUP_RE.sub("", s)


def pad(s, w):
    """按显示宽度右补空格（CJK=2，剥离 markup 标签），用于列对齐"""
    plain = _plain(s)
    width = sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in plain)
    return s + " " * max(0, w - width)


def truncate(s, w):
    """按显示宽度截断（不切半个 CJK 字符，保留 markup 标签）"""
    width = 0
    out = []
    for c in s:
        cw = 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
        if width + cw > w:
            break
        out.append(c)
        width += cw
    return "".join(out)

