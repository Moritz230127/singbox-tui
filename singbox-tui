        ("ArchLinux 镜像", "https://mirrors.kernel.org/archlinux/iso/latest/archlinux-x86_64.iso.zst"),
    ],
}


def load_config():
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
        for k, v in DEFAULT_CONFIG.items():
            cfg.setdefault(k, v)
        return cfg
    except Exception:
        return dict(DEFAULT_CONFIG)


def save_config(cfg):
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
    except Exception:
        pass


# ---------- clash API（asyncio + curl 子进程） ----------

def _api_auth():
    try:
        secret = open(SECRET_PATH).read().strip()
        return ["-H", "Authorization: Bearer %s" % secret] if secret else []
    except Exception:
        return []


async def _curl(args, timeout=8):
    """执行 curl 子进程，返回 (returncode, stdout)"""
    try:
        proc = await asyncio.create_subprocess_exec(
            "curl", "-s", "--max-time", str(timeout), *args,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout + 3)
        return proc.returncode, out.decode(errors="replace").strip()
    except Exception:
        return None, ""


async def api_get(path, timeout=5):
    rc, out = await _curl(_api_auth() + [API + path], timeout)
    if rc == 0 and out:
        try:
            return json.loads(out)
        except Exception:
            return None
    return None


async def api_put(path, data, timeout=5):
    rc, _ = await _curl(["-X", "PUT", API + path, "-d", data] + _api_auth(), timeout)
    return rc == 0


async def get_proxy_state():
    """返回 (当前选中, auto 组选中)"""
    p = await api_get("/proxies/proxy")
    a = await api_get("/proxies/auto")
    return (p.get("now", "—") if p else "—"), (a.get("now", "—") if a else "—")


async def get_nodes():
    """从 clash API 动态获取节点列表（修复 v3 硬编码）"""
    p = await api_get("/proxies/proxy")
    if p and "all" in p:
        return p["all"]
    return ["auto", "vless-v6", "vless-v4", "tuic-v6", "tuic-v4", "hy2-v6", "hy2-v4"]


async def node_delay(tag, timeout=6):
    """单节点延迟(ms)，失败返回 None"""
    url = "/proxies/%s/delay?timeout=5000&url=http%%3A%%2F%%2Fwww.gstatic.com%%2Fgenerate_204" % tag
    d = await api_get(url, timeout=timeout)
    if d and "delay" in d:
        return d["delay"]
    return None


async def set_proxy(name):
    """切换节点/模式（clash API PUT，即时生效）"""
    return await api_put("/proxies/proxy", '{"name":"%s"}' % name)


async def ping_vps(ip, port=443, timeout=5):
    """TCP connect 测 VPS 直连延迟(ms)，失败返回 None"""
    t0 = time.time()
    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(ip, port), timeout=timeout)
        writer.close()
        await writer.wait_closed()
        return int((time.time() - t0) * 1000)
    except Exception:
        return None


async def get_traffic():
    """/traffic 累计字节 (up, down)"""
    d = await api_get("/traffic", timeout=3)
    if d:
        return d.get("up", 0), d.get("down", 0)
    return 0, 0


async def get_version():
    """sing-box 版本"""
    d = await api_get("/version", timeout=3)
    if d and "version" in d:
        return d["version"]
    return "—"


async def get_node_ips():
    """从 config.json outbounds 解析 tag→server:port（sudo -n cat）"""
    try:
        proc = await asyncio.create_subprocess_exec(
            "sudo", "-n", "cat", "/etc/sing-box/config.json",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=5)
        cfg = json.loads(out.decode())
        ips = {}
        for ob in cfg.get("outbounds", []):
            if ob.get("type") in ("vless", "tuic", "hysteria2") and ob.get("tag"):
                ips[ob["tag"]] = "%s:%s" % (ob.get("server", "?"), ob.get("server_port", "?"))
        return ips
    except Exception:
        return {}


async def get_default_iface():
    """默认路由网卡"""
    proc = await asyncio.create_subprocess_exec(
        "ip", "route", "show", "default",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    out, _ = await proc.communicate()
    line = out.decode().strip()
    if "dev " in line:
        return line.split("dev ")[1].split()[0]
    return "—"


async def run_script(script, *args, timeout=120):
    """调配套脚本，返回输出（失败返回空串）"""
    try:
        proc = await asyncio.create_subprocess_exec(
            os.path.expanduser("~/.local/bin/" + script), *args,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT)
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout)
        return out.decode(errors="replace").strip()
    except Exception:
        return ""


def fmt_bytes(n):
    """人类可读字节"""
    try:
        n = float(n)
    except Exception:
        return "0B"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return "%.1f%s" % (n, unit) if unit != "B" else "%d%s" % (int(n), unit)
        n /= 1024
    return "%d%s" % (int(n), "TB")


# ---------- 服务状态 ----------

async def is_active():
    proc = await asyncio.create_subprocess_exec(
        "systemctl", "is-active", "sing-box",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    out, _ = await proc.communicate()
    return out.decode().strip() == "active"


async def service(action):
    proc = await asyncio.create_subprocess_exec(
        "sudo", "-n", "systemctl", action, "sing-box",
        stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
    await proc.communicate()


async def egress():
    rc, out = await _curl(["-4", "https://api.ipify.org"], 6)
    return out if rc == 0 else "—"


async def err_warn_count(hours=1):
    proc = await asyncio.create_subprocess_exec(
        "journalctl", "-u", "sing-box", "--since", "%d hours ago" % hours, "--no-pager",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    out, _ = await proc.communicate()
    try:
        return sum(1 for line in out.decode(errors="replace").splitlines()
                   if "ERROR" in line or "WARNING" in line)
    except Exception:
        return 0


async def uptime_str():
    proc = await asyncio.create_subprocess_exec(
        "systemctl", "show", "sing-box", "-p", "ActiveEnterTimestamp", "--value",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    out, _ = await proc.communicate()
    ts = out.decode().strip()
    if not ts:
        return "—"
    try:
        t = time.mktime(time.strptime(ts, "%a %Y-%m-%d %H:%M:%S %Z"))
        secs = max(0, int(time.time() - t))
    except Exception:
        return "—"
    d, rem = divmod(secs, 86400)
    h, m = divmod(rem, 3600)
    m, _ = divmod(m, 60)
    if d > 0:
        return "%d天%d时" % (d, h)
    if h > 0:
        return "%d时%d分" % (h, m)
    return "%d分" % m


async def conn_count(vps_ip):
    """连接数：ss 统计到 VPS 的 TCP 连接（IP 从配置读取，修复 v3 硬编码）"""
    proc = await asyncio.create_subprocess_exec(
        "ss", "-tn",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    out, _ = await proc.communicate()
    return sum(1 for line in out.decode(errors="replace").splitlines()
               if vps_ip in line and ":443" in line)


# ---------- 测速 ----------

async def speed_test(url, timeout=45):
    """经 mixed 代理下载测速，返回 (MB/s, 耗时s) 或 None"""
    try:
        proc = await asyncio.create_subprocess_exec(
            "curl", "-s", "-x", "http://127.0.0.1:%d" % PROXY_PORT,
            "--max-time", str(timeout), "-o", "/dev/null",
            "-w", "%{speed_download} %{time_total}", url,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout + 5)
        if proc.returncode == 0 and out:
            speed, total = out.decode().split()
            return float(speed) / 1048576, float(total)
    except Exception:
        pass
    return None


async def udp_health():
    """UDP 链路丢包率检测（复用 singbox-udp-health）"""
    try:
        proc = await asyncio.create_subprocess_exec(
            os.path.expanduser("~/.local/bin/singbox-udp-health"), "8",
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=90)
        lines = out.decode(errors="replace").strip().splitlines()
        return lines[-1] if lines else "检测失败"
    except Exception:
        return "检测失败"


# ---------- 日志流 ----------

async def journal_stream(callback, stop_event):
    """journalctl -f 异步流，逐行回调。stop_event 置位时退出。"""
    proc = await asyncio.create_subprocess_exec(
        "journalctl", "-u", "sing-box", "-f", "--no-pager", "-o", "short-iso",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    if proc.stdout is None:
        return
    try:
        while not stop_event.is_set():
            line = await proc.stdout.readline()
            if not line:
                break
            result = callback(line.decode(errors="replace").rstrip())
            if asyncio.iscoroutine(result):
                await result
    finally:
        proc.kill()
        await proc.wait()


